{
    "name": "jdz/frontui",
    "type": "library",
    "description": "Framework-agnostic front UI helpers (asset versioning, lazy/zoom image tags) for simple Slim/Twig sites",
    "keywords": [
        "JDZ",
        "utilities",
        "html",
        "twig",
        "front",
        "ui",
        "asset",
        "image"
    ],
    "homepage": "https://jdz.joffreydemetz.com/frontui",
    "license": "MIT",
    "authors": [
        {
            "name": "Joffrey Demetz",
            "email": "joffrey.demetz@gmail.com",
            "homepage": "https://joffreydemetz.com",
            "role": "Lead"
        }
    ],
    "require": {
        "php": ">=8.2",
        "jdz/ui": "^1.0",
        "twig/twig": "^3.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "JDZ\\FrontUi\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "JDZ\\FrontUi\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit --colors=always --testdox"
    }
}